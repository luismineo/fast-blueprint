{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "outDir": "dist",
    // O catálogo default é JSON em `data/`, fora de `src/`, porque é onde a
    // spec 06 § Estrutura o coloca. Com `rootDir: "src"` o import dele não
    // compila.
    "rootDir": "."
  },
  // O glob de `data` precisa da extensão: a expansão de diretório do
  // TypeScript não recolhe `.json` sozinha, nem com `resolveJsonModule`.
  "include": ["src", "data/**/*.json"]
}
