{
  "name": "fast-blueprint",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @planta/app dev",
    "build": "pnpm --filter @planta/app build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --build tsconfig.build.json && pnpm --filter @planta/app run typecheck",
    "lint": "eslint .",
    "depcruise": "depcruise --config .dependency-cruiser.cjs packages",
    "version:sync": "node scripts/version-sync.mjs",
    "version:check": "node scripts/version-check.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "fast-check": "^4.9.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
